# ============================================================
#  .gitignore —— 仓库"门卫"规则清单
#  列在这里的文件/文件夹不会被上传到 GitHub
# ============================================================

# ---- Python 运行时产生的缓存 ----
__pycache__/
*.py[cod]
*$py.class

# ---- 虚拟环境（体积大，且每人电脑上自己生成）----
venv/
.venv/
env/

# ---- Jupyter Notebook 自动备份点 ----
.ipynb_checkpoints/

# ---- 打包产物 ----
build/
dist/
*.egg-info/

# ---- 含有密码/密钥的敏感文件（千万别上传！）----
.env
*.key
*_password*
*_token*

# ---- 日志与临时文件 ----
*.log
*.tmp
~$*

# ---- 编辑器 / IDE 的个人配置 ----
.vscode/
.idea/
*.swp

# ---- Windows / macOS 系统自动生成的杂物 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 大文件 / 数据集（按需取消注释）----
# *.zip
# *.rar
# data/
